# Home Assistant REST API
# API base URL, e.g. http://homeassistant.local:8123/api
REACT_APP_HA_API_URL=<your HA API base URL>

# Long-lived access token (HA: Profile -> Security -> Long-lived access tokens)
REACT_APP_HA_API_TOKEN=<your HA long-lived access token>

# Outdoor weather entity (weather.*; uses qweather_* attributes and forecast service)
REACT_APP_HA_WEATHER_ENTITY_ID=<your HA weather entity id>

# Indoor air quality sensor (sensor.*)
REACT_APP_HA_INDOOR_AQI_ENTITY_ID=<your HA indoor AQI sensor entity id>

# Indoor temperature / humidity / pressure sensors (sensor.*)
REACT_APP_HA_INDOOR_TEMPERATURE_ENTITY_ID=<your HA indoor temperature sensor entity id>
REACT_APP_HA_INDOOR_HUMIDITY_ENTITY_ID=<your HA indoor humidity sensor entity id>
REACT_APP_HA_INDOOR_PRESSURE_ENTITY_ID=<your HA indoor pressure sensor entity id>
